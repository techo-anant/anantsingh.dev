---
/**
 * Content test page (BUILD_PLAN §14, PR 2): every collection entry as data.
 * Reading through src/lib/content.ts also runs the cross-entry checks on
 * every build. Not linked from the site and marked noindex.
 * TODO: remove or restrict to dev before the repo/site goes public.
 */
import Base from '../../layouts/Base.astro';
import {
  getCredentials,
  getLedger,
  getPapers,
  getProjects,
  getResearch,
  getRoles,
  getSite,
} from '../../lib/content';

const [roles, software, ai, papers, research, ledger, credentials, site] = await Promise.all([
  getRoles(),
  getProjects('software'),
  getProjects('ai'),
  getPapers(),
  getResearch(),
  getLedger(),
  getCredentials(),
  getSite(),
]);
---

<Base title="Content · anantsingh.dev" noindex>
  <main class="page">
    <h1>Content collections</h1>
    <p class="note">
      Highlighted values are placeholders still waiting for real content (BUILD_PLAN §15).
    </p>

    <section>
      <h2>
        roles <span>Software timeline</span>
      </h2>
      <ol>
        {roles.map((r) => (
          <li>
            <strong>{r.title}</strong> · {r.org}
            {r.current && <em> · current</em>}
            <br />
            <span class="stored">
              stored, not shown: period {r.period ?? '—'} · detail {r.detail ?? '—'}
            </span>
          </li>
        ))}
      </ol>
    </section>

    {[
      { label: 'Software gallery', items: software },
      { label: 'AI gallery', items: ai },
    ].map(({ label, items }) => (
      <section>
        <h2>
          projects <span>{label}</span>
        </h2>
        <ol start="0">
          {items.map((p) => (
            <li>
              <strong>{p.name}</strong> · {p.demo}
              <br />
              {p.line}
              <br />
              {p.meta && <code>{p.meta}</code>}
              {p.href ? (
                <>
                  {p.cta} <code>{p.href}</code>
                </>
              ) : (
                <em>no link pill</em>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section>
      <h2>
        papers <span>AI world</span>
      </h2>
      {papers.map((p) => (
        <p>
          <code>{p.badge}</code>
          <br />
          <strong>{p.title}</strong>: {p.subtitle}
          <br />
          {p.authors.join(' · ')}
          <br />
          <code>{p.href}</code>
          {p.pdf && (
            <>
              <br />
              pdf: <code>{p.pdf}</code>
            </>
          )}
        </p>
      ))}
    </section>

    <section>
      <h2>
        research <span>Robotics world</span>
      </h2>
      <p>
        <strong>{research.title}</strong> · {research.org}
        <br />
        {research.period} · with {research.supervisor}
        <br />
        {research.tags.map((t) => (
          <code class="tag">{t}</code>
        ))}
      </p>
    </section>

    <section>
      <h2>
        ledger <span>Accounting world</span>
      </h2>
      <table>
        <tbody>
          {ledger.map((l) => (
            <tr>
              <td>{l.period}</td>
              <td>
                <strong>{l.title}</strong> · {l.org}
              </td>
              <td>{l.status}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>
        {credentials.map((c) => (
          <code class="tag">{c.label}</code>
        ))}
      </p>
    </section>

    <section>
      <h2>
        site <span>Contact and cover</span>
      </h2>
      <p>
        <code>{site.email}</code> · <code>{site.linkedin}</code> · <code>{site.github}</code>
        <br />
        scholar: <code class:list={{ ph: !site.scholar }}>{site.scholar ?? 'not set'}</code> ·
        resume: <code>{site.resume ?? 'not set'}</code>
      </p>
      <p>{site.blurb}</p>
      <ol class="hand">
        {site.coverFragments.map((f) => (
          <li>{f}</li>
        ))}
      </ol>
    </section>
  </main>
</Base>

<style>
  .page {
    display: grid;
    gap: 40px;
    max-width: 760px;
    margin-inline: auto;
    padding: 56px 24px 96px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--cover-ink);
  }

  h1 {
    font-family: var(--font-serif-cover);
    font-size: 48px;
    font-weight: 400;
  }

  h2 {
    margin-bottom: 12px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--cover-ink);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
  }

  h2 span {
    color: var(--cover-muted);
    font-weight: 400;
  }

  ol {
    display: grid;
    gap: 12px;
    margin: 0;
    padding-left: 24px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  td {
    padding: 6px 8px 6px 0;
    border-bottom: 1px solid rgba(31, 26, 21, 0.12);
    vertical-align: top;
  }

  code {
    font-family: var(--font-mono);
    font-size: 12px;
    overflow-wrap: anywhere;
  }

  .tag {
    display: inline-block;
    margin: 4px 6px 0 0;
    padding: 2px 8px;
    border: 1px solid var(--cover-accent);
    color: var(--cover-accent);
  }

  .ph {
    padding: 0 4px;
    background: #ffe08a;
  }

  .stored {
    font-size: 13px;
    color: var(--cover-muted);
  }

  .note {
    color: var(--cover-muted);
  }

  .hand {
    font-family: var(--font-hand);
    font-size: 20px;
  }
</style>
