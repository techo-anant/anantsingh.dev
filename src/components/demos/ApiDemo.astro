      opacity: 1;
      transform: none;
    }

    97%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  .ap-q1 {
    animation: apQ1 7s ease infinite;
  }

  @keyframes apQ2 {
    0%,
