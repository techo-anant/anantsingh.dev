---
/**
 * An IT general controls workpaper (§8): users → app (admin) → database
 * (customer data). Controls are checked one by one; "Access reviews" fails (a
 * terminated user still has admin), a red trace runs from the user to the
 * customer data, a high-risk finding appears, then access is removed and the
 * control is restored. Ported from the reference (Live.dc.html, auditVals()).
 *
 * Not a CSS loop: ./audit.ts steps `ap` through 0..14 every 720ms while the
 * Accounting panel is open, and marks elements with [data-on], plus [data-fail]
 * and [data-fixed] on the root. A 560×420 scene.
 * Decorative: the panel's text line describes it for screen readers.
 */
const CONTROLS = ['Change management', 'Backups & recovery', 'Data security'];
const CHECK = 'M3 9.5l4 4 8-9';
---

<div class="demo" aria-hidden="true" data-audit>
  <svg class="sys" width="560" height="110" viewBox="0 0 560 110" data-a="sys">
    <g class="mono" font-size="10" letter-spacing="1" fill="#4A5468">
      <text x="0" y="10">
        USERS
      </text>
      <text x="205" y="10">
        APP
      </text>
      <text x="410" y="10">
        DATABASE
      </text>
    </g>
    <rect
      x="0"
      y="18"
      width="150"
      height="56"
      rx="3"
      fill="#FFFFFF"
      stroke="#0B1220"
      stroke-opacity="0.35"
    ></rect>
    <rect
      x="205"
      y="18"
      width="150"
      height="56"
      rx="3"
      fill="#FFFFFF"
      stroke="#0B1220"
      stroke-opacity="0.35"
    ></rect>
    <rect
      x="410"
      y="18"
      width="150"
      height="56"
      rx="3"
      fill="#FFFFFF"
      stroke="#0B1220"
      stroke-opacity="0.35"
    ></rect>
    <line x1="150" y1="46" x2="205" y2="46" stroke="#0B1220" stroke-opacity="0.35"></line>
    <line x1="355" y1="46" x2="410" y2="46" stroke="#0B1220" stroke-opacity="0.35"></line>
    <circle cx="26" cy="48" r="8" fill="#0B1220" fill-opacity="0.75"></circle>
    <circle cx="54" cy="48" r="8" fill="#0B1220" fill-opacity="0.75"></circle>
    <circle class="user" cx="82" cy="48" r="8"></circle>
    <circle cx="110" cy="48" r="8" fill="#0B1220" fill-opacity="0.75"></circle>
    <rect
      x="248"
      y="34"
      width="64"
      height="24"
      rx="3"
      fill="none"
      stroke="#00338D"
      stroke-opacity="0.6"
    ></rect>
    <text class="mono" x="280" y="50" text-anchor="middle" font-size="10" fill="#00338D">
      admin
    </text>
    <g class="mono" font-size="10" fill="#0B1220">
      <text x="485" y="44" text-anchor="middle">
        customer
      </text>
      <text x="485" y="57" text-anchor="middle">
        data
      </text>
    </g>
    <path
      class="trace"
      pathLength="1"
      d="M 82 58 C 82 96, 280 100, 280 60 M 312 46 C 360 92, 470 96, 485 62"
      fill="none"
      stroke="#C8102E"
      stroke-width="1.8"
      stroke-dasharray="1"
    ></path>
  </svg>

  <div class="head" data-a="sys">
    <span>CONTROL</span>
    <span>RESULT</span>
  </div>

  {CONTROLS.map((name, i) => (
    <div class="row" style={`top: ${124 + i * 44}px`} data-a={`row${i}`}>
      <span class="control">{name}</span>
      <span class="late" data-a={`row${i}`}>
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="#3D7A12"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={CHECK} />
        </svg>
      </span>
    </div>
  ))}

  <div class="row access" style="top: 256px" data-a="row3">
    <span class="access-name">
      <span class="control">Access reviews</span>
      <span class="sub" data-a="fail">
        terminated user still has admin
      </span>
    </span>
    <span class="result">
      <span class="checking" data-a="checking">
        checking…
      </span>
      <span class="mark" data-a="fail">
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="#C8102E"
          stroke-width="2.2"
          stroke-linecap="round"
        >
          <path d="M4 4l10 10M14 4L4 14"></path>
        </svg>
      </span>
      <span class="mark" data-a="fixed">
        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          stroke="#3D7A12"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d={CHECK}></path>
        </svg>
      </span>
    </span>
  </div>

  <div class="finding" data-a="finding">
    <span class="finding-label">FINDING · HIGH RISK</span>
    <span class="finding-text">Former employee could reach customer data</span>
  </div>

  <div class="done" data-a="done">
    <span class="done-text">access removed, control restored</span>
    <span class="double" aria-hidden="true">
      <span></span>
      <span></span>
    </span>
  </div>
</div>

<style>
  .demo {
    position: relative;
    width: 560px;
    height: 420px;
    background: #f7f8fa;
    box-shadow: 0 0 0 18px #f7f8fa;
    color: #0b1220;
  }

  /* Every step fades (auditVals: opacity .45s). */
  [data-a] {
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  [data-a][data-on] {
    opacity: 1;
  }

  /* The ticks land 0.35s after their row. */
  .late {
    transition-delay: 0.35s;
  }

  .mono,
  .head,
  .checking,
  .sub,
  .finding-label {
    font-family: var(--font-mono);
  }

  .sys {
    position: absolute;
    top: 0;
    left: 0;
  }

  .user {
    fill: #0b1220;
    opacity: 0.75;
    transition:
      opacity 0.6s ease,
      fill 0.3s ease;
  }

  [data-fail] .user {
    fill: #c8102e;
    opacity: 1;
  }

  [data-fixed] .user {
    opacity: 0;
  }

  .trace {
    opacity: 0;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 1s ease,
      opacity 0.4s ease;
  }

  [data-trace] .trace {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  .head {
    position: absolute;
    top: 104px;
    left: 0;
    display: flex;
    width: 560px;
    padding: 0 8px 6px;
    justify-content: space-between;
    border-bottom: 1px solid #0b1220;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #4a5468;
  }

  .row {
    position: absolute;
    left: 0;
    display: flex;
    width: 560px;
    height: 38px;
    padding: 0 8px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(11, 18, 32, 0.12);
  }

  .row > span {
    display: inline-flex;
  }

  .control {
    font-family: var(--font-ledger);
    font-size: 16px;
  }

  .access {
    background: transparent;
    box-shadow: inset 3px 0 0 transparent;
    transition:
      opacity 0.45s ease,
      background 0.4s ease,
      box-shadow 0.4s ease;
  }

  [data-fail] .access {
    background: rgba(200, 16, 46, 0.07);
    box-shadow: inset 3px 0 0 #c8102e;
  }

  .access-name {
    align-items: baseline;
    gap: 12px;
  }

  .sub {
    font-size: 11px;
    color: #c8102e;
  }

  .result {
    position: relative;
    width: 70px;
    height: 18px;
  }

  .checking,
  .mark {
    position: absolute;
    top: 0;
    right: 0;
  }

  .checking {
    font-size: 11px;
    color: #4a5468;
  }

  .finding {
    position: absolute;
    top: 318px;
    left: 0;
    display: flex;
    width: 330px;
    padding: 9px 14px;
    flex-direction: column;
    gap: 3px;
    border: 1px solid #c8102e;
    border-radius: 3px;
    background: #fff;
  }

  .finding-label {
    font-size: 10px;
    letter-spacing: 0.08em;
    color: #c8102e;
  }

  .finding-text {
    font-family: var(--font-sans);
    font-size: 13px;
    transition: opacity 0.4s ease;
  }

  [data-fixed] .finding-text {
    opacity: 0.5;
    text-decoration: line-through;
  }

  .done {
    position: absolute;
    top: 324px;
    left: 350px;
    display: flex;
    width: 210px;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .done-text {
    font-family: var(--font-ledger);
    font-size: 20px;
    font-style: italic;
    text-align: right;
    color: #3d7a12;
  }

  .double {
    display: flex;
    width: 120px;
    flex-direction: column;
    gap: 3px;
  }

  .double > span {
    height: 2px;
    background: #0b1220;
  }
</style>
