<style>
  .demo {
    position: relative;
    width: 560px;
    height: 420px;
    font-family: var(--font-mono);
    color: #eceff4;
  }

  @keyframes protoRide {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }

    4% {
      opacity: 1;
    }

    62% {
      offset-distance: 100%;
    }

    92% {
      offset-distance: 100%;
      opacity: 1;
    }

    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  .dn-proto {
    animation: protoRide 8s cubic-bezier(0.25, 0.55, 0.3, 1) infinite;
  }

  @keyframes repel {
    0% {
      transform: scale(4.5);
      opacity: 0.45;
    }

    55% {
      transform: scale(1.6);
      opacity: 0.2;
    }

    66%,
    100% {
      transform: scale(1);
      opacity: 0;
    }
  }

  .dn-repel {
    animation: repel 8s ease-out infinite;
  }

  @keyframes tint {
    0%,
    55% {
      fill: #6b778a;
    }

    68%,
    92% {
      fill: #57e4e9;
    }

    100% {
      fill: #6b778a;
    }
  }

  .dn-dot {
    fill: #6b778a;
    animation: tint 8s ease infinite;
  }

  @keyframes drawE {
    0% {
      stroke-dashoffset: 1;
    }

    90%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  .dn-energy {
    stroke-dasharray: 1;
    animation: drawE 8s linear infinite;
  }
</style>
