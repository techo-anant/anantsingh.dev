---
/**
 * Learning from scratch: a loss curve draws itself through micrograd, makemore, tokenization and transformers; the last checkpoint pulses "still training" (§8).
 * Ported from the reference (Live.dc.html); a 560×420 scene that loops forever.
 * Decorative: the panel's text line describes it for screen readers.
 */
---

<div class="demo" aria-hidden="true">
  <svg
    aria-hidden="true"
    width="560"
    height="420"
    viewBox="0 0 560 420"
    style="position: absolute; inset: 0;"
  >
    <line x1="50" y1="60" x2="50" y2="340" stroke="rgba(236,239,244,0.25)"></line>
    <line x1="50" y1="340" x2="530" y2="340" stroke="rgba(236,239,244,0.25)"></line>
    <g style="font-family: var(--font-mono)" font-size="11" fill="#9AA4B2">
      <text x="56" y="54">
        loss
      </text>
      <text x="530" y="360" text-anchor="end">
        steps
      </text>
    </g>
    <path
      d="M 50 80 C 90 86, 100 140, 118 150 S 180 226, 220 236 S 300 280, 350 289 S 430 300, 470 303 S 510 306, 530 306"
      fill="none"
      stroke="rgba(87,228,233,0.18)"
      stroke-width="2"
    ></path>
    <path
      class="lr-curve"
      pathLength="1"
      d="M 50 80 C 90 86, 100 140, 118 150 S 180 226, 220 236 S 300 280, 350 289 S 430 300, 470 303 S 510 306, 530 306"
      fill="none"
      stroke="#57E4E9"
      stroke-width="2.5"
    ></path>
    <g class="lr-cp" style="animation-delay: 1.0s;">
      <circle cx="118" cy="150" r="6" fill="#0A0D14" stroke="#57E4E9" stroke-width="2"></circle>
      <text
        x="118"
        y="134"
        text-anchor="middle"
        style="font-family: var(--font-mono)"
        font-size="11"
        fill="#B8C0CC"
      >
        micrograd
      </text>
    </g>
    <g class="lr-cp" style="animation-delay: 2.1s;">
      <circle cx="220" cy="236" r="6" fill="#0A0D14" stroke="#57E4E9" stroke-width="2"></circle>
      <text
        x="220"
        y="220"
        text-anchor="middle"
        style="font-family: var(--font-mono)"
        font-size="11"
        fill="#B8C0CC"
      >
        makemore
      </text>
    </g>
    <g class="lr-cp" style="animation-delay: 3.3s;">
      <circle cx="350" cy="289" r="6" fill="#0A0D14" stroke="#57E4E9" stroke-width="2"></circle>
      <text
        x="350"
        y="273"
        text-anchor="middle"
        style="font-family: var(--font-mono)"
        font-size="11"
        fill="#B8C0CC"
      >
        tokenization
      </text>
    </g>
    <g class="lr-cp" style="animation-delay: 4.4s;">
      <circle cx="470" cy="303" r="6" fill="#0A0D14" stroke="#57E4E9" stroke-width="2"></circle>
      <text
        x="470"
        y="287"
        text-anchor="middle"
        style="font-family: var(--font-mono)"
        font-size="11"
        fill="#B8C0CC"
      >
        transformers
      </text>
    </g>
    <circle
      class="lr-live"
      cx="470"
      cy="303"
      r="6"
      fill="none"
      stroke="#57E4E9"
      stroke-width="2"
    ></circle>
    <text
      x="470"
      y="330"
      text-anchor="middle"
      style="font-family: var(--font-mono)"
      font-size="10"
      fill="#57E4E9"
    >
      still training
    </text>
  </svg>
</div>

<style>
  .demo {
    position: relative;
    width: 560px;
    height: 420px;
    font-family: var(--font-mono);
    color: #eceff4;
  }

  @keyframes drawL {
    0% {
      stroke-dashoffset: 1;
    }

    75%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  .lr-curve {
    stroke-dasharray: 1;
    animation: drawL 6.5s ease-in-out infinite;
  }

  @keyframes cpIn {
    0% {
      opacity: 0;
    }

    6%,
    92% {
      opacity: 1;
    }

    100% {
      opacity: 0;
    }
  }

  .lr-cp {
    opacity: 0;
    animation: cpIn 6.5s ease infinite;
  }

  @keyframes livePulse {
    0% {
      r: 6;
      opacity: 0.9;
    }

    100% {
      r: 22;
      opacity: 0;
    }
  }

  .lr-live {
    animation: livePulse 1.6s ease-out infinite;
  }
</style>
