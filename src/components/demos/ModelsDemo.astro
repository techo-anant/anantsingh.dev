    style="position: absolute; left: 400px; top: 326px; width: 140px; height: 79px; border-radius: 8px; background: linear-gradient(150deg, #0B2430 0%, #155A63 55%, #57E4E9 130%); box-shadow: 0 10px 24px rgba(0,0,0,0.5);"
  ></span>
</div>

<style>
  .demo {
    position: relative;
    width: 560px;
    height: 420px;
    font-family: var(--font-mono);
    color: #eceff4;
  }

  @keyframes tokDrop {
    0%,
    8% {
      opacity: 0;
      transform: translateY(-20px);
    }

    16%,
    88% {
      opacity: 1;
      transform: none;
    }

    96%,
    100% {
      opacity: 0;
    }
  }

  .md-tok {
    animation: tokDrop 7s ease infinite;
  }

  @keyframes barGrow {
    0%,
    14% {
      transform: scaleY(0);
    }

    26%,
    88% {
      transform: scaleY(1);
    }

    96%,
    100% {
      transform: scaleY(0);
    }
  }

  .md-bar {
    animation: barGrow 7s cubic-bezier(0.3, 0.7, 0.3, 1) infinite;
  }

  @keyframes promptIn {
    0%,
    46% {
      opacity: 0;
    }

    54%,
    88% {
      opacity: 1;
    }

    96%,
    100% {
      opacity: 0;
    }
  }

  .md-prompt {
    animation: promptIn 7s ease infinite;
  }

  @keyframes imgIn {
    0%,
    58% {
      opacity: 0;
      filter: blur(10px);
    }

    70%,
    88% {
      opacity: 1;
      filter: blur(0);
    }

    96%,
    100% {
      opacity: 0;
    }
  }

  .md-img {
    animation: imgIn 7s ease infinite;
  }
</style>
