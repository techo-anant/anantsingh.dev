---
/**
 * Software world, "the terminal" (BUILD_PLAN §7.1).
 *
 * Text column, role timeline, and the object controls in three states:
 *   idle     dashed ring + "▸ open projects/" around the </> cloud
 *   gallery  three hotspots over the gallery icons (particle shape 4)
 *   focus    a panel per project: demo, meta, line, "← projects", repo link
 * Desktop panels fly in from their hotspot; on phone they are opaque sheets.
 *
 * Object-anchored pieces use --ox, --oy (px) and --k (artboard scale) set by
 * worlds.ts, so they line up with the particles at any size. Behavior: ./software.ts.
 */
import { getProjects, getRoles } from '../../lib/content';
import ApiDemo from '../demos/ApiDemo.astro';
import FiscaleDemo from '../demos/FiscaleDemo.astro';
import ShortsDemo from '../demos/ShortsDemo.astro';

const [roles, projects] = await Promise.all([getRoles(), getProjects('software')]);
const DEMOS = { ShortsDemo, FiscaleDemo, ApiDemo } as const;

/** Hotspot centers relative to the object, in artboard px (§7.1): desktop, phone. */
const SPOTS = [
  { d: [-230, -115], p: [-102, -54] },
  { d: [231, -115], p: [102, -54] },
  { d: [0, 144], p: [0, 73] },
] as const;
/** Desktop panel top-left relative to the object (artboard px, §7.1: 640×640 at 700,118). */
const PANEL = [-322, -314] as const;
---

<div class="sw" data-sw>
  <div class="col">
    <p class="eyebrow fluid">
      <span class="accent">~/anant/software</span> $ ls
    </p>
    <h2 class="title fluid">
      Software that ships
      <span class="cursor" aria-hidden="true">
        _
      </span>
    </h2>
  </div>

  <div class="block">
    <span class="dash" aria-hidden="true"></span>
    <span class="note fluid" aria-hidden="true">
      next commit…
    </span>
    <span class="line" aria-hidden="true"></span>
    <ol class="roles">
      {roles.map((r, i) => (
        <li class="role" style={`--i: ${i}`}>
          <span class:list={['node', { 'node-head': r.current }]} aria-hidden="true" />
          <span class="role-title fluid">{r.title}</span>
          <span class="role-org fluid">{r.org}</span>
        </li>
      ))}
    </ol>
  </div>

  <!-- idle -->
  <div class="idle" data-sw-idle>
    <span class="ring" aria-hidden="true"></span>
    <button
      class="hit"
      type="button"
      aria-label="Open my projects"
      data-sw-open
      tabindex="-1"
    ></button>
    <button class="hint fluid" type="button" data-sw-open data-sw-opener>
      ▸ open projects/
    </button>
  </div>

  <!-- gallery -->
  <div class="gallery" data-sw-gallery hidden>
    {projects.map((p, i) => (
      <>
        <button
          class="spot"
          type="button"
          aria-label={p.name}
          data-sw-focus={i}
          style={`--dx: ${SPOTS[i].d[0]}; --dy: ${SPOTS[i].d[1]}; --px: ${SPOTS[i].p[0]}; --py: ${SPOTS[i].p[1]}`}
        />
        <span
          class="spot-label fluid"
          aria-hidden="true"
          style={`--dx: ${SPOTS[i].d[0]}; --dy: ${SPOTS[i].d[1]}; --px: ${SPOTS[i].p[0]}; --py: ${SPOTS[i].p[1]}`}
        >
          {p.name}
        </span>
      </>
    ))}
    <span class="pick fluid" aria-hidden="true">
      pick one
    </span>
    <button class="close close-gallery fluid" type="button" data-sw-close>
      close ×
    </button>
  </div>

  <!-- focus: one panel per project -->
  {projects.map((p, i) => {
    const Demo = DEMOS[p.demo as keyof typeof DEMOS];
    const ox = SPOTS[i].d[0] - PANEL[0],
      oy = SPOTS[i].d[1] - PANEL[1];
    return (
      <div class="focus" data-sw-panel={i} role="group" aria-label={p.name} hidden>
        <button class="close close-sheet fluid" type="button" data-sw-close>
          close ×
        </button>
        <div class="panel-pos">
          <div class="panel" style={`--fx: ${ox}px; --fy: ${oy}px`}>
            <div class="demo-box">
              <div class="demo-scale">{Demo && <Demo />}</div>
            </div>
            {p.meta && <p class="meta fluid">{p.meta}</p>}
            <p class="pline fluid">{p.line}</p>
            <div class="actions">
              <button class="pill fluid" type="button" data-sw-back>
                ← projects
              </button>
              {p.href && (
                <a class="pill pill-cta fluid" href={p.href} target="_blank" rel="noopener">
                  {p.cta}
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    );
  })}
</div>

<script>
  import { initSoftware } from './software';

  initSoftware();
</script>

<style>
  /* Phone layout first (§7.1 phone, §4.4 phone grid); desktop below. */
  .sw {
    --accent: var(--software-accent);
    --muted: var(--software-muted);

    position: absolute;
    inset: 0;
  }

  .col {
    position: absolute;
    top: calc(84 / 844 * 100cqh);
    right: 24px;
    left: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .eyebrow {
    --fs: 12;

    color: var(--muted);
  }

  .accent {
    color: var(--accent);
  }

  .title {
    --fs: 38;

    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  /* Role timeline */
  .block {
    position: absolute;
    top: calc(556 / 844 * 100cqh);
    right: 24px;
    left: 24px;
    padding-left: 30px;
  }

  .dash,
  .note,
  .line {
    position: absolute;
  }

  .dash {
    top: -40px;
    left: 7px;
    width: 2px;
    height: 34px;
    background: repeating-linear-gradient(
      180deg,
      rgba(95, 237, 131, 0.7) 0 4px,
      transparent 4px 9px
    );
  }

  .note {
    --fs: 10;

    top: -36px;
    left: 20px;
    color: var(--software-annotation);
  }

  .line {
    top: 14px;
    bottom: 26px;
    left: 7px;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 0.3s ease;
  }

  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role {
    position: relative;
    display: flex;
    min-height: 44px;
    padding: 7px 0 11px;
    flex-direction: column;
    gap: 3px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .node {
    position: absolute;
    top: 12px;
    left: -29px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--software-bg);
  }

  .node-head {
    background: var(--accent);
    animation: headPulse 2.4s ease-in-out infinite;
  }

  .role-title {
    --fs: 18;

    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--software-ink);
  }

  .role-org {
    --fs: 11;

    color: var(--muted);
  }

  /* Reveal (§7.1): only while the world is active and the worlds have entered. */
  .dash,
  .note {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.worlds[data-entered] .world[data-active]) .dash,
  :global(.worlds[data-entered] .world[data-active]) .note {
    opacity: 1;
    transition: opacity 0.8s ease 1.7s;
  }

  :global(.worlds[data-entered] .world[data-active]) .line {
    transform: scaleY(1);
    transition: transform 1.1s cubic-bezier(0.6, 0, 0.2, 1) 0.45s;
  }

  :global(.worlds[data-entered] .world[data-active]) .role {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s ease calc(0.8s + var(--i) * 0.25s),
      transform 0.6s ease calc(0.8s + var(--i) * 0.25s);
  }

  /* Object controls, anchored to the particle object (--ox, --oy, --k). */
  .ring,
  .hit,
  .spot,
  .spot-label {
    position: absolute;
  }

  .ring {
    --d: calc(260px * var(--k, 1));

    top: calc(var(--oy) - var(--d) / 2);
    left: calc(var(--ox) - var(--d) / 2);
    width: var(--d);
    height: var(--d);
    border: 1px dashed rgba(95, 237, 131, 0.35);
    border-radius: 50%;
    pointer-events: none;
    animation: ringPulse 3.2s ease-in-out infinite;
  }

  .hit {
    --d: calc(300px * var(--k, 1));

    top: calc(var(--oy) - var(--d) / 2);
    left: calc(var(--ox) - var(--d) / 2);
    width: var(--d);
    height: var(--d);
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .hint,
  .close {
    position: absolute;
    min-height: 44px;
    font-family: var(--font-mono);
    cursor: pointer;
  }

  .hint {
    --fs: 12;

    top: calc(var(--oy) + 136px * var(--k, 1));
    right: 16px;
    padding: 0 8px;
    border: none;
    background: none;
    color: var(--accent);
  }

  .hint:hover {
    color: var(--software-hint-hover);
  }

  /* Gallery */
  .spot {
    --w: calc(116px * var(--k, 1));
    --h: calc(96px * var(--k, 1));

    top: calc(var(--oy) + var(--py) * 1px * var(--k, 1) - var(--h) / 2);
    left: calc(var(--ox) + var(--px) * 1px * var(--k, 1) - var(--w) / 2);
    width: var(--w);
    height: var(--h);
    padding: 0;
    border: none;
    border-radius: 16px;
    background: transparent;
    cursor: pointer;
  }

  .spot-label {
    --fs: 11;
    --w: calc(140px * var(--k, 1));

    top: calc(var(--oy) + var(--py) * 1px * var(--k, 1) + 50px * var(--k, 1));
    left: calc(var(--ox) + var(--px) * 1px * var(--k, 1) - var(--w) / 2);
    width: var(--w);
    text-align: center;
    color: var(--software-ink);
    pointer-events: none;
  }

  .pick {
    --fs: 11;

    position: absolute;
    top: calc(var(--oy) + 148px * var(--k, 1));
    left: 24px;
    color: var(--muted);
    animation: fadeUp 0.5s ease 0.9s both;
  }

  .close {
    --fs: 12;

    padding: 0 14px;
    border: 1px solid rgba(240, 246, 252, 0.25);
    border-radius: 999px;
    background: rgba(13, 17, 23, 0.7);
    color: var(--software-ink);
  }

  .close-gallery {
    top: calc(var(--oy) + 136px * var(--k, 1));
    right: 16px;
  }

  /* Focus: phone = opaque sheet over the section (§7.6). */
  .focus {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    padding: calc(132 / 844 * 100cqh) 27px 0;
    flex-direction: column;
    align-items: center;
    background: var(--software-bg);
    animation: fadeUp 0.5s ease both;
  }

  .close-sheet {
    top: calc(72 / 844 * 100cqh);
    right: 16px;
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .demo-box {
    position: relative;
    width: calc(336px * var(--k, 1));
    height: calc(252px * var(--k, 1));
    flex: none;
  }

  .demo-scale {
    position: absolute;
    top: 0;
    left: 0;
    transform: scale(calc(0.6 * var(--k, 1)));
    transform-origin: 0 0;
  }

  .meta {
    --fs: 10;

    font-family: var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .pline {
    --fs: 17;

    font-family: var(--font-sans);
    line-height: 1.4;
    text-align: center;
    color: var(--software-ink);
  }

  .actions {
    display: flex;
    gap: 10px;
  }

  .pill {
    --fs: 12;

    display: inline-flex;
    min-height: 44px;
    padding: 0 16px;
    align-items: center;
    border: 1px solid rgba(240, 246, 252, 0.25);
    border-radius: 999px;
    background: rgba(13, 17, 23, 0.7);
    font-family: var(--font-mono);
    color: var(--software-ink);
    text-decoration: none;
    cursor: pointer;
  }

  .pill-cta {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--software-bg);
  }

  /* Focus rings in the world's accent (§12). */
  .hint:focus-visible,
  .close:focus-visible,
  .spot:focus-visible,
  .pill:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  /* Desktop (§7.1, §4.4). Keep in sync with src/lib/layout.ts. */
  @media (width >= 820px) and (orientation: landscape) and (height >= 600px) {
    .col {
      top: calc(168 / 900 * 100cqh);
      right: auto;
      left: var(--col-x);
      width: clamp(420px, 38.9cqw, 680px);
      gap: 20px;
    }

    .eyebrow {
      --fs: 14;
    }

    .title {
      --fs: 64;

      line-height: 1.02;
    }

    .block {
      top: calc(500 / 900 * 100cqh);
      right: auto;
      left: var(--col-x);
      width: clamp(420px, 38.9cqw, 680px);
      padding-left: 34px;
    }

    .dash {
      top: -44px;
      left: 9px;
      height: 40px;
    }

    .note {
      --fs: 11;

      top: -42px;
      left: 24px;
    }

    .line {
      top: 16px;
      bottom: 30px;
      left: 9px;
    }

    .role {
      padding: 10px 0 18px;
      gap: 4px;
    }

    .node {
      top: 17px;
      left: -31px;
    }

    .role-title {
      --fs: 23;
    }

    .role-org {
      --fs: 12;
    }

    .ring {
      --d: calc(420px * var(--k, 1));
    }

    .hit {
      --d: calc(460px * var(--k, 1));
    }

    .hint {
      --fs: 13;

      top: calc(var(--oy) + 252px * var(--k, 1));
      right: auto;
      left: calc(var(--ox) - 120px * var(--k, 1));
      width: calc(240px * var(--k, 1));
      padding: 0;
    }

    .spot {
      --w: calc(210px * var(--k, 1));
      --h: calc(180px * var(--k, 1));

      top: calc(var(--oy) + var(--dy) * 1px * var(--k, 1) - var(--h) / 2);
      left: calc(var(--ox) + var(--dx) * 1px * var(--k, 1) - var(--w) / 2);
      border-radius: 22px;
    }

    /* Labels show on hover or keyboard focus (always visible on phone). */
    .spot-label {
      --fs: 13;
      --w: calc(210px * var(--k, 1));

      top: calc(var(--oy) + var(--dy) * 1px * var(--k, 1) + 96px * var(--k, 1));
      left: calc(var(--ox) + var(--dx) * 1px * var(--k, 1) - var(--w) / 2);
      opacity: 0;
      transform: translateY(6px);
      transition:
        opacity 0.25s ease,
        transform 0.25s ease;
    }

    .spot:hover + .spot-label,
    .spot:focus-visible + .spot-label {
      opacity: 1;
      transform: none;
    }

    .pick {
      --fs: 12;

      top: calc(var(--oy) + 268px * var(--k, 1));
      left: calc(var(--ox) - 80px * var(--k, 1));
      width: calc(160px * var(--k, 1));
      text-align: center;
    }

    .close-gallery {
      top: calc(112 / 900 * 100cqh);
      right: auto;
      left: calc(var(--ox) + 218px * var(--k, 1));
      padding: 0 16px;
    }

    /* Desktop focus: a 640×640 panel that flies in from its hotspot. */
    .focus {
      padding: 0;
      background: none;
      animation: none;
      pointer-events: none;
    }

    .close-sheet {
      display: none;
    }

    .panel-pos {
      position: absolute;
      top: calc(var(--oy) - 314px * var(--k, 1));
      left: calc(var(--ox) - 322px * var(--k, 1));
      width: 640px;
      height: 640px;
      transform: scale(var(--k, 1));
      transform-origin: 0 0;
    }

    .panel {
      width: 640px;
      height: 640px;
      transform-origin: var(--fx) var(--fy);
      pointer-events: auto;
      animation: flyIn 0.75s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    .demo-box {
      width: 560px;
      height: 420px;
    }

    .demo-scale {
      transform: none;
    }

    /* Inside the scaled panel, sizes are artboard px (the panel scales them). */
    .meta {
      font-size: 11px;
      animation: fadeUp 0.5s ease 0.45s both;
    }

    .pline {
      font-size: 20px;
      animation: fadeUp 0.5s ease 0.5s both;
    }

    .actions {
      gap: 12px;
      animation: fadeUp 0.5s ease 0.7s both;
    }

    .pill {
      padding: 0 18px;
      font-size: 12px;
    }
  }
</style>
