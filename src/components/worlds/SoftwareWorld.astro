---
/**
 * Software world, "the terminal" (BUILD_PLAN §7.1): the text column and the
 * role timeline. The object controls (open projects → gallery → project
 * panels with the Shorts, Fiscale and API demos) are the shared <Gallery>.
 * Colors come from the section's [data-world="software"] tokens.
 */
import { getProjects, getRoles } from '../../lib/content';
import ApiDemo from '../demos/ApiDemo.astro';
import FiscaleDemo from '../demos/FiscaleDemo.astro';
import ShortsDemo from '../demos/ShortsDemo.astro';
import Gallery from './Gallery.astro';

const [roles, projects] = await Promise.all([getRoles(), getProjects('software')]);
const DEMOS = { ShortsDemo, FiscaleDemo, ApiDemo } as const;
---

<div class="sw">
  <div class="col">
    <p class="eyebrow fluid">
      <span class="accent">~/anant/software</span> $ ls
    </p>
    <h2 class="title fluid">
      Software that ships
      <span class="cursor" aria-hidden="true">
        _
      </span>
    </h2>
  </div>

  <div class="block">
    <span class="dash" aria-hidden="true"></span>
    <span class="note fluid" aria-hidden="true">
      next commit…
    </span>
    <span class="line" aria-hidden="true"></span>
    <ol class="roles">
      {roles.map((r, i) => (
        <li class="role" style={`--i: ${i}`}>
          <span class:list={['node', { 'node-head': r.current }]} aria-hidden="true" />
          <span class="role-title fluid">{r.title}</span>
          <span class="role-org fluid">{r.org}</span>
        </li>
      ))}
    </ol>
  </div>

  <Gallery
    world={0}
    items={projects}
    openLabel="Open my projects"
    hint="▸ open projects/"
    backLabel="← projects"
  >
    {projects.map((p, i) => {
      const Demo = DEMOS[p.demo as keyof typeof DEMOS];
      return Demo && <Demo slot={`demo-${i}`} />;
    })}
  </Gallery>
</div>

<style>
  /* Phone layout first (§7.1 phone, §4.4 phone grid); desktop below. */
  .sw {
    position: absolute;
    inset: 0;
  }

  .col {
    position: absolute;
    top: calc(84 / 844 * 100cqh);
    right: 24px;
    left: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .eyebrow {
    --fs: 12;

    color: var(--muted);
  }

  .accent {
    color: var(--accent);
  }

  .title {
    --fs: 38;

    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  /* Role timeline */
  .block {
    position: absolute;
    top: calc(556 / 844 * 100cqh);
    right: 24px;
    left: 24px;
    padding-left: 30px;
  }

  .dash,
  .note,
  .line {
    position: absolute;
  }

  .dash {
    top: -40px;
    left: 7px;
    width: 2px;
    height: 34px;
    background: repeating-linear-gradient(
      180deg,
      rgba(95, 237, 131, 0.7) 0 4px,
      transparent 4px 9px
    );
  }

  .note {
    --fs: 10;

    top: -36px;
    left: 20px;
    color: var(--annotation);
  }

  .line {
    top: 14px;
    bottom: 26px;
    left: 7px;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top center;
    transition: transform 0.3s ease;
  }

  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role {
    position: relative;
    display: flex;
    min-height: 44px;
    padding: 7px 0 11px;
    flex-direction: column;
    gap: 3px;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .node {
    position: absolute;
    top: 12px;
    left: -29px;
    width: 12px;
    height: 12px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--bg);
  }

  .node-head {
    background: var(--accent);
    animation: headPulse 2.4s ease-in-out infinite;
  }

  .role-title {
    --fs: 18;

    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .role-org {
    --fs: 11;

    color: var(--muted);
  }

  /* Reveal (§7.1): only while the world is active and the worlds have entered. */
  .dash,
  .note {
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.worlds[data-entered] .world[data-active]) .dash,
  :global(.worlds[data-entered] .world[data-active]) .note {
    opacity: 1;
    transition: opacity 0.8s ease 1.7s;
  }

  :global(.worlds[data-entered] .world[data-active]) .line {
    transform: scaleY(1);
    transition: transform 1.1s cubic-bezier(0.6, 0, 0.2, 1) 0.45s;
  }

  :global(.worlds[data-entered] .world[data-active]) .role {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s ease calc(0.8s + var(--i) * 0.25s),
      transform 0.6s ease calc(0.8s + var(--i) * 0.25s);
  }

  /* Desktop (§7.1, §4.4). Keep in sync with src/lib/layout.ts. */
  @media (width >= 820px) and (orientation: landscape) and (height >= 600px) {
    .col {
      top: calc(168 / 900 * 100cqh);
      right: auto;
      left: var(--col-x);
      width: clamp(420px, 38.9cqw, 680px);
      gap: 20px;
    }

    .eyebrow {
      --fs: 14;
    }

    .title {
      --fs: 64;

      line-height: 1.02;
    }

    .block {
      top: calc(500 / 900 * 100cqh);
      right: auto;
      left: var(--col-x);
      width: clamp(420px, 38.9cqw, 680px);
      padding-left: 34px;
    }

    .dash {
      top: -44px;
      left: 9px;
      height: 40px;
    }

    .note {
      --fs: 11;

      top: -42px;
      left: 24px;
    }

    .line {
      top: 16px;
      bottom: 30px;
      left: 9px;
    }

    .role {
      padding: 10px 0 18px;
      gap: 4px;
    }

    .node {
      top: 17px;
      left: -31px;
    }

    .role-title {
      --fs: 23;
    }

    .role-org {
      --fs: 12;
    }
  }
</style>
