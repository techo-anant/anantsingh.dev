---
/**
 * Accounting world, "the ledger" (BUILD_PLAN §7.4): eyebrow, headline, the
 * ledger (newest first) with status icons, a double rule and credential chips.
 * The object controls are idle and focus only: "▸ open the audit" opens the
 * WORKPAPER panel with the AuditDemo state machine (./demos/audit.ts).
 * Colors come from [data-world="accounting"]. Behavior: ./solo.ts.
 */
import { getCredentials, getLedger } from '../../lib/content';
import AuditDemo from '../demos/AuditDemo.astro';

const [ledger, credentials] = await Promise.all([getLedger(), getCredentials()]);
const STATUS = { upcoming: 'Upcoming', ongoing: 'Ongoing', completed: 'Completed' } as const;
---

<div class="accounting">
  <div class="col">
    <p class="eyebrow fluid">Accounting and audit</p>
    <h2 class="title fluid">
      Where the numbers <em class="tie">have to tie.</em>
    </h2>
  </div>

  <div class="block">
    <span class="dash" aria-hidden="true"></span>
    <span class="note fluid" aria-hidden="true">
      next entry…
    </span>
    <div class="head" aria-hidden="true">
      <span>PERIOD</span>
      <span>ENTRY</span>
      <span></span>
    </div>
    <ol class="ledger" aria-label="Ledger">
      {ledger.map((e, i) => (
        <li class="entry" style={`--i: ${i}`}>
          <span class="period bf">{e.period}</span>
          <span class="what">
            <span class="entry-title bf">{e.title}</span>
            <span class="org bf">{e.org}</span>
          </span>
          {e.status === 'upcoming' && (
            <span class="icon next" role="img" aria-label={STATUS.upcoming} />
          )}
          {e.status === 'ongoing' && (
            <svg class="icon" role="img" aria-label={STATUS.ongoing} viewBox="0 0 18 18">
              <circle cx="9" cy="9" r="6" fill="currentColor" />
            </svg>
          )}
          {e.status === 'completed' && (
            <svg
              class="icon done"
              role="img"
              aria-label={STATUS.completed}
              viewBox="0 0 18 18"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M3 9.5l4 4 8-9" />
            </svg>
          )}
        </li>
      ))}
    </ol>
    <div class="double" aria-hidden="true">
      <span></span>
      <span></span>
    </div>
    <ul class="chips" aria-label="Credentials">
      {credentials.map((c) => (
        <li class="chip bf">{c.label}</li>
      ))}
    </ul>
  </div>

  <div class="solo" data-solo="3">
    <!-- idle -->
    <div data-solo-idle>
      <span class="ring" aria-hidden="true"></span>
      <button
        class="hit"
        type="button"
        aria-label="Open the audit view"
        data-solo-open
        tabindex="-1"
      ></button>
      <button class="hint fluid" type="button" data-solo-open data-solo-opener>
        ▸ open the audit
      </button>
    </div>

    <!-- focus -->
    <div class="focus" data-solo-panel role="group" aria-label="The audit" hidden>
      <div class="panel-pos">
        <div class="panel">
          <div class="wp">
            <span class="wp-label fluid">WORKPAPER · IT GENERAL CONTROLS</span>
            <button class="close fluid" type="button" data-solo-close>
              close ×
            </button>
          </div>
          <div class="demo-box">
            <div class="demo-scale">
              <AuditDemo />
            </div>
          </div>
          <p class="pline fluid">Auditing the systems the numbers depend on.</p>
          <p class="headed fluid">IS / IT audit · where I'm headed</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import { initAudits } from '../demos/audit';
  import { initSolos } from './solo';

  initSolos();
  initAudits();
</script>

<style>
  /* Phone first (§7.4 phone, §7.6 sheet); desktop below. */
  .accounting {
    --success: var(--accounting-success);
    --body: var(--accounting-body);
    --chip-line: rgba(0, 51, 141, 0.4);

    position: absolute;
    inset: 0;
  }

  .col {
    position: absolute;
    top: calc(84 / 844 * 100cqh);
    right: 24px;
    left: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .eyebrow {
    --fs: 11;

    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .title {
    /* 36, not 38: in Libre Caslon "Where the numbers" needs 353px of the 342px column. */
    --fs: 36;

    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .tie {
    color: var(--accent);
  }

  /*
   * The ledger (§7.4) scales with width AND height (1em = 16 artboard px), so short
   * screens (375×667, 1280×720) shrink it instead of running into the footer.
   */
  .block {
    position: absolute;
    top: calc(548 / 844 * 100cqh);
    right: 24px;
    left: 24px;
    font-size: clamp(11px, min(100cqw * 16 / 390, 100cqh * 16 / 844), 22px);
  }

  .bf,
  .head > span {
    font-size: calc(var(--fs) / 16 * 1em);
  }

  .dash,
  .note {
    position: absolute;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .dash {
    top: -40px;
    left: 0;
    width: 2px;
    height: 34px;
    background: repeating-linear-gradient(180deg, rgba(0, 51, 141, 0.6) 0 4px, transparent 4px 9px);
  }

  .note {
    --fs: 10;

    top: -36px;
    left: 12px;
    font-family: var(--font-mono);
    color: var(--annotation);
  }

  :global(.worlds[data-entered] .world[data-active]) .dash,
  :global(.worlds[data-entered] .world[data-active]) .note {
    opacity: 1;
    transition: opacity 0.8s ease 2.2s;
  }

  /* Phone: no PERIOD / ENTRY header, a single ink rule instead. */
  .head {
    display: none;
  }

  .ledger {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--ink);
    list-style: none;
  }

  .entry {
    display: grid;
    padding: 0.3125em 0;
    grid-template-columns: 5.75em minmax(0, 1fr) 1.25em;
    gap: 0.625em;
    align-items: center;
    border-bottom: 1px solid rgba(11, 18, 32, 0.12);
    opacity: 0;
    transform: translateX(-10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  :global(.worlds[data-entered] .world[data-active]) .entry {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease calc(0.8s + var(--i) * 0.22s),
      transform 0.5s ease calc(0.8s + var(--i) * 0.22s);
  }

  .period {
    --fs: 9.5;

    font-family: var(--font-mono);
    color: var(--muted);
  }

  .what {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .entry-title {
    --fs: 14.5;

    line-height: 1.22;
    color: var(--ink);
  }

  .org {
    --fs: 11;

    font-family: var(--font-sans);
    color: var(--muted);
  }

  .icon {
    width: 1em;
    height: 1em;
    color: var(--accent);
  }

  .icon.done {
    color: var(--success);
  }

  .icon.next {
    width: 0.625em;
    height: 0.625em;
    margin: 0.125em;
    border: 2px solid var(--accent);
    border-radius: 50%;
    animation: lgNext 2.4s ease-in-out infinite;
  }

  @keyframes lgNext {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(0, 51, 141, 0.5);
    }

    50% {
      box-shadow: 0 0 0 7px rgba(0, 51, 141, 0);
    }
  }

  .double {
    display: flex;
    padding-top: 0.3125em;
    flex-direction: column;
    gap: 3px;
  }

  .double > span {
    height: 1px;
    background: var(--ink);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375em;
    margin: 0;
    padding: 0.625em 0 0;
    list-style: none;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  :global(.worlds[data-entered] .world[data-active]) .chips {
    opacity: 1;
    transition: opacity 0.8s ease 1.9s;
  }

  .chip,
  .headed {
    font-family: var(--font-mono);
    color: var(--accent);
    border: 1px solid var(--chip-line);
    border-radius: 3px;
  }

  .chip {
    --fs: 10;

    padding: 0.3em 0.8em;
    letter-spacing: 0.03em;
  }

  /* Object controls, anchored to the object via --ox, --oy, --k. */
  .solo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .solo button {
    pointer-events: auto;
  }

  .ring,
  .hit {
    position: absolute;
  }

  .ring {
    --d: calc(260px * var(--k, 1));

    top: calc(var(--oy) - var(--d) / 2);
    left: calc(var(--ox) - var(--d) / 2);
    width: var(--d);
    height: var(--d);
    border: 1px dashed rgba(0, 51, 141, 0.35);
    border-radius: 50%;
    pointer-events: none;
    animation: ringPulse 3.2s ease-in-out infinite;
  }

  .hit {
    --d: calc(300px * var(--k, 1));

    top: calc(var(--oy) - var(--d) / 2);
    left: calc(var(--ox) - var(--d) / 2);
    width: var(--d);
    height: var(--d);
    padding: 0;
    border: none;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .hint,
  .close {
    --fs: 12;

    min-height: 44px;
    border: none;
    background: none;
    font-family: var(--font-mono);
    color: var(--accent);
    cursor: pointer;
  }

  .hint {
    position: absolute;
    top: calc(var(--oy) + 136px * var(--k, 1));
    right: 16px;
    padding: 0 8px;
  }

  .hint:hover {
    color: var(--hint-hover);
  }

  /* Focus: phone = opaque sheet over the section (§7.6), WORKPAPER row first. */
  .focus {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    padding: calc(132 / 844 * 100cqh) 27px 0;
    flex-direction: column;
    align-items: center;
    background: var(--bg);
    pointer-events: auto;
    animation: fadeUp 0.5s ease both;
  }

  .panel-pos {
    align-self: stretch;
  }

  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }

  .wp {
    align-self: stretch;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(11, 18, 32, 0.2);
  }

  .wp-label {
    --fs: 10;

    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    color: var(--muted);
  }

  /* Phone: the plain-text close sits at the sheet's top right. */
  .close {
    position: absolute;
    top: calc(72 / 844 * 100cqh);
    right: 16px;
    padding: 0 14px;
  }

  .close:hover {
    color: var(--hint-hover);
  }

  .demo-box {
    position: relative;
    width: calc(336px * var(--k, 1));
    height: calc(252px * var(--k, 1));
    flex: none;
  }

  .demo-scale {
    position: absolute;
    top: 0;
    left: 0;
    transform: scale(calc(0.6 * var(--k, 1)));
    transform-origin: 0 0;
  }

  .pline {
    --fs: 17;

    line-height: 1.4;
    text-align: center;
    color: var(--body);
  }

  .headed {
    --fs: 11;

    display: inline-flex;
    min-height: 36px;
    padding: 0 14px;
    align-items: center;
    letter-spacing: 0.04em;
  }

  /* Focus rings in the world's accent (§12). */
  .hint:focus-visible,
  .close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  /* Desktop (§7.4, §4.4). Keep in sync with src/lib/layout.ts. */
  @media (width >= 820px) and (orientation: landscape) and (height >= 600px) {
    /* 640 wide, not 600: in Libre Caslon "Where the numbers" needs ~624px at 66px. */
    .col {
      top: calc(168 / 900 * 100cqh);
      right: auto;
      left: var(--col-x);
      width: clamp(440px, 44.4cqw, 760px);
      gap: 20px;
    }

    .eyebrow {
      --fs: 12;
    }

    .title {
      --fs: 66;

      line-height: 1.04;
    }

    .block {
      top: calc(500 / 900 * 100cqh);
      right: auto;
      left: var(--col-x);
      width: clamp(420px, 41.7cqw, 720px);
      font-size: clamp(11px, min(100cqw * 16 / 1440, 100cqh * 16 / 900), 22px);
    }

    .dash {
      top: -46px;
      height: 40px;
    }

    .note {
      --fs: 11;

      top: -44px;
      left: 14px;
    }

    .head {
      --fs: 10;

      display: grid;
      padding-bottom: 0.5em;
      grid-template-columns: 8.25em minmax(0, 1fr) 1.5em;
      gap: 0.875em;
      border-bottom: 1px solid var(--ink);
      font-family: var(--font-mono);
      letter-spacing: 0.08em;
      color: var(--muted);
    }

    .ledger {
      border-top: none;
    }

    .entry {
      padding: 0.5em 0;
      grid-template-columns: 8.25em minmax(0, 1fr) 1.5em;
      gap: 0.875em;
    }

    .period {
      --fs: 12;
    }

    .what {
      gap: 2px;
    }

    .entry-title {
      --fs: 19;

      line-height: normal;
    }

    .org {
      --fs: 12;
    }

    .icon {
      width: 1.125em;
      height: 1.125em;
    }

    .icon.next {
      width: 0.75em;
      height: 0.75em;
      margin: 0.1875em;
    }

    .double {
      padding-top: 0.375em;
    }

    .chips {
      gap: 0.5em;
      padding-top: 0.875em;
    }

    .chip {
      --fs: 11;

      padding: 0.3636em 0.9091em;
      letter-spacing: 0.04em;
    }

    .ring {
      --d: calc(420px * var(--k, 1));
    }

    .hit {
      --d: calc(460px * var(--k, 1));
    }

    /* The shared 240px hint row. */
    .hint {
      --fs: 13;

      top: calc(var(--oy) + 252px * var(--k, 1));
      right: auto;
      left: calc(var(--ox) - 120px * var(--k, 1));
      width: calc(240px * var(--k, 1));
      padding: 0;
    }

    /* Desktop focus: a 640×680 panel at (700, 104) that flies in from the object. */
    .focus {
      padding: 0;
      background: none;
      pointer-events: none;
      animation: none;
    }

    .panel-pos {
      position: absolute;
      top: calc(var(--oy) - 328px * var(--k, 1));
      left: calc(var(--ox) - 322px * var(--k, 1));
      width: 640px;
      height: 680px;
      transform: scale(var(--k, 1));
      transform-origin: 0 0;
    }

    .panel {
      width: 640px;
      height: 680px;
      gap: 18px;
      transform-origin: 322px 328px;
      pointer-events: auto;
      animation: flyIn 0.75s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    /* Inside the scaled panel, sizes are artboard px (the panel scales them). */
    .wp {
      display: flex;
      width: 560px;
      padding-bottom: 0;
      align-self: center;
      align-items: center;
      justify-content: space-between;
    }

    .wp-label {
      font-size: 10px;
    }

    .close {
      position: static;
      padding: 0 2px;
      font-size: 12px;
    }

    .demo-box {
      width: 560px;
      height: 420px;
    }

    .demo-scale {
      transform: none;
    }

    .pline {
      font-size: 19px;
      animation: fadeUp 0.5s ease 0.5s both;
    }

    .headed {
      font-size: 11px;
      animation: fadeUp 0.5s ease 0.7s both;
    }
  }
</style>
