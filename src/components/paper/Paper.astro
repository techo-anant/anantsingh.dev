---
/**
 * Paper texture (BUILD_PLAN §2.2): SVG fractal-noise grain in warm brown plus
 * the vignette. Used by the cover and the Contact world. Purely decorative.
 */
interface Props {
  /** Unique filter id, needed when more than one Paper is on the page. */
  id: string;
}

const { id } = Astro.props;
const filterId = `grain-${id}`;
---

<div class="paper" aria-hidden="true">
  <svg class="grain" width="100%" height="100%">
    <filter id={filterId}>
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.85"
        numOctaves="2"
        stitchTiles="stitch"
      ></feTurbulence>
      <feColorMatrix values="0 0 0 0 0.45  0 0 0 0 0.38  0 0 0 0 0.28  0 0 0 0.22 0"></feColorMatrix>
    </filter>
    <rect width="100%" height="100%" filter={`url(#${filterId})`}></rect>
  </svg>
  <div class="vignette"></div>
</div>

<style>
  .paper,
  .grain,
  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .grain {
    opacity: 0.5;
    mix-blend-mode: multiply;
  }

  .vignette {
    background: var(--cover-vignette);
  }
</style>
