---
/**
 * The cover (BUILD_PLAN §5): "An Ongoing Autobiography, by Anant Kumar Singh"
 * on manuscript paper, with handwriting that writes itself and a lamp that
 * follows the pointer. Clicking anywhere zooms into "Anant" and the ink
 * transition reveals the worlds underneath. Behavior lives in ./cover.ts.
 */
import { getSite } from '../../lib/content';
import Paper from '../paper/Paper.astro';

const site = await getSite();
---

<div class="cover" data-cover data-fragments={JSON.stringify(site.coverFragments)}>
  <!-- §5.1 layer 2: receives the ink mask during the transition. -->
  <div class="cover-mask" data-cover-mask>
    <div class="paper-bg" aria-hidden="true"></div>
    <div class="zoom" data-cover-zoom>
      <canvas class="hand" aria-hidden="true" data-cover-canvas></canvas>
      <div class="title-wrap">
        <h1 class="title fluid">
          An <em>Ongoing</em> Autobiography
        </h1>
        <p class="byline fluid">
          <em>by</em> <span data-anant>Anant</span> Kumar Singh
        </p>
      </div>
      <p class="hint fluid" aria-hidden="true">
        <span class="on-desktop">Click anywhere to turn the page</span>
        <span class="on-phone">Tap anywhere to turn the page</span>
      </p>
    </div>
    <Paper id="cover" />
  </div>
  <!-- §5.1 layer 3: the whole cover is the "turn the page" button. -->
  <button class="go" type="button" aria-label="Enter the autobiography" data-cover-go></button>
</div>

<noscript>
  <style is:inline>
    /* Without JavaScript there is no page turn: show the worlds directly. */
    .cover {
      display: none !important;
    }
  </style>
</noscript>

<script>
  import { initCover } from './cover';

  initCover();
</script>

<style>
  .cover {
    position: fixed;
    inset: 0;
    z-index: 20;
    color: var(--cover-ink);
  }

  .cover[data-done] {
    visibility: hidden;
  }

  .cover-mask,
  .paper-bg,
  .zoom,
  .hand {
    position: absolute;
    inset: 0;
  }

  .cover-mask {
    mask-repeat: no-repeat;
    mask-size: 100% 100%;
  }

  .paper-bg {
    background: var(--cover-paper);
  }

  .hand {
    width: 100%;
    height: 100%;
  }

  /* §5.2 Title block: centered column, slightly above center. */
  .title-wrap {
    position: absolute;
    inset: 0;
    display: flex;
    padding-bottom: 10%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    pointer-events: none;
  }

  .title {
    --fs: 58;

    padding-inline: 16px;
    font-family: var(--font-serif-cover);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-align: center;
    color: var(--cover-ink);
    animation: rise 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }

  .title em {
    color: var(--cover-accent);
  }

  .byline {
    --fs: 22;

    /* Phone needs the extra gap, or the title shows as giant letters while
       zooming into "Anant" (§5.2). */
    margin-top: 72px;
    font-family: var(--font-serif-cover);
    line-height: 1.1;
    text-align: center;
    color: var(--cover-byline);
    animation: rise 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) 0.9s both;
  }

  .hint {
    --fs: 10;

    position: absolute;
    right: 0;
    bottom: 24px;
    left: 0;
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
    color: var(--cover-muted);
    pointer-events: none;
    animation: rise 1s ease 5s both;
  }

  .hint span {
    animation: breathe 3.4s ease-in-out 6s infinite;
  }

  .on-desktop {
    display: none;
  }

  .go {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .go:focus-visible {
    outline: 2px solid var(--cover-accent);
    outline-offset: -8px;
  }

  .cover[data-done] .go {
    display: none;
  }

  /* Desktop layout. Keep in sync with src/lib/layout.ts. */
  @media (width >= 820px) and (orientation: landscape) and (height >= 600px) {
    .title {
      --fs: 108;

      line-height: 0.92;
    }

    .byline {
      --fs: 30;

      margin-top: 0;
    }

    .hint {
      --fs: 12;

      bottom: 28px;
    }

    .on-desktop {
      display: inline;
    }

    .on-phone {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .title,
    .byline,
    .hint,
    .hint span {
      animation: none;
    }
  }
</style>
